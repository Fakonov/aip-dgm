# console on the C3 native USB (UART0 would fight the backlight on GPIO21)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# --- ?????? ---
CONFIG_IDF_TARGET="esp32c3"
# ??ESP32-C3 ??PSRAM,?????CONFIG_SPIRAM??
# --- Flash ---
# FoloToy AI Passport ??????/????????? 8MB Flash??CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# ??? 8MB ????????? detect?????idf.py merge-bin??CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# ???????????NVS??HY data ???????????? factory app??????????????CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- ?????USB-Serial-JTAG(C3 ??? USB,GPIO18/19)---
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_QRCODE=y
# LVGL ??? malloc ?????KB)????????????????????????,???????????? RAM??# ??demo UI ????24KB ???;??????????????????????????????????CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- ??? ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 ?????BLE??????????????peripheral ?????????host ?????CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# --- Digimon port: BLE/WiFi not used by the emulator ---
# BT disabled to avoid pulling the whole NimBLE stack (and its submodule tree).
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n


