# console on the C3 native USB (UART0 would fight the backlight on GPIO21)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# --- ?????? ---
CONFIG_IDF_TARGET="esp32c3"
# ??ESP32-C3 ??PSRAM,?????CONFIG_SPIRAM??
# --- Flash ---
# FoloToy AI Passport ??????/????????? 8MB Flash??CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# ??? 8MB ????????? detect?????idf.py merge-bin??CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# ???????????NVS??HY data ???????????? factory app??????????????CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- ?????USB-Serial-JTAG(C3 ??? USB,GPIO18/19)---
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_QRCODE=y
# LVGL ??? malloc ?????KB)????????????????????????,???????????? RAM??# ??demo UI ????24KB ???;??????????????????????????????????CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- ??? ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 ?????BLE??????????????peripheral ?????????host ?????CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# --- Digimon port: BLE/WiFi not used by the emulator ---
# BT disabled to avoid pulling the whole NimBLE stack (and its submodule tree).
CONFIG_BT_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n


# --- audit 2026-11-10 ---------------------------------------------------
# 8 MB flash.  Write the CHOICE member, not the derived string: an earlier
# version wrote CONFIG_ESPTOOLPY_FLASHSIZE="8MB" here, which Kconfig ignores,
# so a from-scratch build came up as 2 MB and the 8 MB partition table did not
# fit.  (R2 audit §0.4.)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# LVGL trim: the app only uses canvas / label / obj / anim.
# Keep THEME_DEFAULT: it supplies the menu panel border.  Turning it off is
# worth 4,848 B (measured, R2 audit §4.6) -- not worth changing the outline.
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_QRCODE=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_BUILD_EXAMPLES=n

# --- audit R2 2026-11-11 ------------------------------------------------
# Everything the shipped image needs but that only lived in the generated
# sdkconfig.  Without these three a from-scratch build produced 839,456 B of
# -Og code with a 64 KB LVGL pool and THEME_SIMPLE compiled in -- buildable,
# but not the firmware we ship.  Gate: delete sdkconfig, build, compare bytes.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_MEM_SIZE_KILOBYTES=40

# Pixel formats: the app only uses RGB565 (canvas / backdrop / icons),
# RGB565_SWAPPED (panel) and A8 (brick tile).  The other eight were compiled in
# and cost 101,552 B of blend code for nothing (R2 audit §4.1: measured, 11
# simulated screenshots pixel-identical).
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=n
CONFIG_LV_DRAW_SW_SUPPORT_RGB888=n
CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888=n
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=n
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED=n
CONFIG_LV_DRAW_SW_SUPPORT_L8=n
CONFIG_LV_DRAW_SW_SUPPORT_AL88=n
CONFIG_LV_DRAW_SW_SUPPORT_I1=n

# LVGL's own TLSF pool (40,960 B .bss + 41,802 B of code) replaced by the libc
# heap: -40,984 B .bss, and "pool exhausted -> lv_obj_create() returns NULL"
# stops being a failure mode.  LV_MEM_SIZE_KILOBYTES above is unused in this
# mode; it stays so flipping back to the builtin allocator reproduces the pool.
CONFIG_LV_USE_CLIB_MALLOC=y
